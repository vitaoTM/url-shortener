<div>
  <h2>Sign up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, class: 'f-f' %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-box" %>

      <%= f.label :password, class: 'f-f' %>
      <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br/>
      <%= f.password_field :password, autocomplete: "new-password", class: "input-box" %>

      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-box" %>

      <div class="py-3">
        <%= f.submit "Sign up", class: 'btn-primary' %>
      </div>
  <% end %>

  <%= render "devise/shared/links" %>

</div>